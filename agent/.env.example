# =============================================================================
# HireWire agent — environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 0 / single-tenant variables (still used by agent/main.py)
# -----------------------------------------------------------------------------

# SignalWire SWML Basic Authentication Credentials.
# Used by single-tenant flows. Multi-tenant mode replaces these with
# per-project credentials stored in the SQLite projects table.
SWML_BASIC_AUTH_USER=signalwire
SWML_BASIC_AUTH_PASSWORD=your-secure-password-here

# Application Domain. The public URL where this agent is reachable.
# Do NOT include trailing slash.
#   - Replit:    https://your-repl-name.your-username.repl.co
#   - Custom:    https://agent.yourdomain.com
APP_DOMAIN=https://your-replit-url.replit.dev

AGENT_PORT=8000
LOG_LEVEL=INFO

# Optional CORS allowlist. Comma-separated origins. Defaults to "*" if unset.
# CORS_ORIGINS=https://app.yourdomain.com,https://staging.app.yourdomain.com

# -----------------------------------------------------------------------------
# Phase 1 / Phase 2 multi-tenant variables (agent/lib/config.py)
# -----------------------------------------------------------------------------

# 32-byte AES-256 key, base64-encoded. Generate with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# Shared secret for web → agent internal API calls. >= 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_API_KEY=

# Optional but used by Phase 1 config — not yet wired into HireWire's email path
# (agent/main.py reads SENDGRID_API_KEY from employee config or its own env).
SENDGRID_API_KEY=SG.placeholder

# Public base URLs for the two services. Must be https in prod (set
# ALLOW_HTTP_URLS=1 to bypass for local dev).
PUBLIC_BASE_URL_AGENT=https://agent.yourdomain.com
PUBLIC_BASE_URL_WEB=https://app.yourdomain.com
# ALLOW_HTTP_URLS=1

# Where the SQLite DB + uploads + audit logs live. Created with mode 0o700.
DATA_DIR=./.data

# Flip on to enable the per-project webhook basic-auth middleware. Until
# this is set, /swml/* /swaig/* /post-prompt/* keep their existing
# single-tenant SWML_BASIC_AUTH_PASSWORD behavior.
# HIREWIRE_MULTI_TENANT_AUTH=1
