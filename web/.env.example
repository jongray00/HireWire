# Frontend environment variables for HireWire (web/)
# Copy this file to web/.env (or set these in Replit Secrets) and fill in values.

# URL of the Python agent backend.
# Local dev:        http://localhost:8000
# Replit (deploy):  https://<your-repl-name>.<username>.repl.co  (port 8000 is also exposed)
# Production:       https://your-public-domain.com
AGENT_BACKEND_URL=http://localhost:8000

# Public URL of the frontend itself (used to build webhook callback URLs).
# Local dev:        http://localhost:5000
# Replit (deploy):  https://<your-repl-name>.<username>.repl.co
APP_URL=http://localhost:5000

# Same value as APP_URL, exposed to the browser bundle.
# Only set if you want the frontend to know its own canonical URL at build time.
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Comma-separated allowlist for the agent backend's CORS middleware.
# Use "*" only for local development. In production list explicit origins.
# Example: https://hirewire.example.com,https://staging.hirewire.example.com
CORS_ORIGINS=*
